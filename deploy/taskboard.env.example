# Copy this file to /etc/taskboard/taskboard.env and make it readable only by
# the taskboard service account (mode 600 or 640). Never commit real secrets.
# Use a least-privilege read-only token. The update checker fails closed without it.
TASKBOARD_GITHUB_REPOSITORY=ralphschuler/Shipyard
TASKBOARD_GITHUB_BRANCH=master
TASKBOARD_GITHUB_TOKEN=
# Exact tags (v0.1.5) or patch-only prefixes (v0.1.*) are accepted.
TASKBOARD_GITHUB_RELEASE_ALLOWLIST=v0.1.*
# Optional local Markdown fallback; otherwise CHANGELOG.md or CHANGELOG.markdown
# in the service working directory is used when GitHub has no changelog body.
TASKBOARD_CHANGELOG_PATH=
# Persistent root for managed project clones, run worktrees and integration
# worktrees. Leave empty to retain the legacy local roots. The service account
# must own the mounted directory and have Git/write access; invalid or missing
# storage blocks runs instead of falling back to local paths.
TASKBOARD_WORKSPACE_ROOT=
